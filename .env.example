# For local development (SQLite - no setup needed)
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"

# For production (PostgreSQL on Neon/Supabase)
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Admin passcode — REQUIRED in production (login is disabled without it)
PASSCODE="choose-a-strong-passcode"

# Secret for signing the admin auth cookie — set a long random string in production
AUTH_SECRET="generate-a-long-random-string"

# Optional — Instagram Graph API for the "השלמת חסרים" (backfill missing reels) button.
# Without these, backfill falls back to the public profile embed (newest ~6 posts only).
# Needs an Instagram professional account linked to a Meta app; the token needs
# instagram_basic + pages_read_engagement (Business Discovery). Free, 200 calls/hour.
# IG_GRAPH_TOKEN="long-lived-user-access-token"
# IG_GRAPH_USER_ID="your-ig-business-account-id"
# IG_GRAPH_VERSION="v24.0"

# Optional — map tiles. Default is OpenStreetMap's keyless standard tiles.
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?api_key=..."
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"

# Optional — enable the Tel Aviv municipal synagogues dataset (prayer times) ONLY
# after receiving written consent from the municipality (its terms restrict reuse).
# TLV_OPENDATA_APPROVED="1"

# Web Push notifications (daily reminder, hilulot, omer). Generate a pair with
#   npx web-push generate-vapid-keys
# Changing the pair later invalidates every existing subscription.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=            # contact URL or mailto:, defaults to the site URL
# Bearer secret for POST /api/push/dispatch — also set as the GitHub Actions
# secret CRON_SECRET, with DISPATCH_URL=https://<site>/api/push/dispatch
# CRON_SECRET=
