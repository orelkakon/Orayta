generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Citation {
  id          String             @id @default(cuid())
  content     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  locations   CitationLocation[]
  quizResults QuizResult[]
}

model CitationLocation {
  id         String   @id @default(cuid())
  citationId String
  masechet   String
  seder      String
  daf        String
  amud       String?
  citation   Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@index([masechet])
  @@index([citationId])
}

model Rabbi {
  id         String   @id @default(cuid())
  name       String
  fullName   String?
  sortYear   Int
  datePeriod String
  isAlive    Boolean  @default(false)
  bio        String
  category   String
  createdAt  DateTime @default(now())
  deathDate  String?
  imageUrl   String?

  @@index([category])
  @@index([sortYear])
}

model Gematria {
  id        String   @id @default(cuid())
  word      String
  value     Int
  createdAt DateTime @default(now())

  @@index([value])
}

model Book {
  id        String   @id @default(cuid())
  title     String
  author    String
  createdAt DateTime @default(now())
  rabbiId   String?

  @@index([author])
  @@index([rabbiId])
}

model Chidush {
  id        String   @id @default(cuid())
  text      String
  source    String?
  author    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String?
  message   String
  rating    Int?
  createdAt DateTime @default(now())
}

model Dedication {
  id        String   @id @default(cuid())
  type      String
  name      String
  status    String   @default("approved")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PageVisit {
  id     String   @id @default(cuid())
  ipHash String   @unique
  seenAt DateTime @default(now())

  @@index([ipHash])
}

model GlobalCounter {
  key   String @id
  value Int    @default(0)
}

model FeedLike {
  id       String @id @default(cuid())
  itemType String
  itemId   String
  reaction String @default("heart")
  likes    Int    @default(0)

  @@unique([itemType, itemId, reaction])
  @@index([itemType])
  @@index([reaction])
}

// Public, anonymous comments on feed posts (content items and reels).
// ipHash is a salted hash used only for DB-backed rate limiting — never
// returned to clients. Authors delete their own comment with a signed
// token kept on their device; the admin can delete any comment.
model FeedComment {
  id        String   @id @default(cuid())
  itemType  String
  itemId    String
  name      String?
  text      String
  ipHash    String
  createdAt DateTime @default(now())

  @@index([itemType, itemId, createdAt])
  @@index([ipHash, createdAt])
}

model InstagramPage {
  id        String          @id @default(cuid())
  username  String          @unique
  url       String
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  reels     InstagramReel[]
}

model InstagramReel {
  id        String         @id @default(cuid())
  pageId    String?
  page      InstagramPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  code      String         @unique
  url       String
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())

  @@index([pageId])
}

// One row per (day, metric) — the whole analytics footprint is a handful of
// tiny rows per day, regardless of traffic volume.
model DailyStat {
  day    String // 'YYYY-MM-DD' in Asia/Jerusalem
  metric String // 'users' | 'feed' | 'content' | 'today' | 'pwa'
  count  Int    @default(0)

  @@id([day, metric])
}

model AppConfig {
  key   String @id
  value String
}

// YouTube channels followed by the "Live Torah" section. Liveness is not
// stored per-channel — a periodically refreshed snapshot lives in AppConfig.
model LiveChannel {
  id        String   @id @default(cuid())
  channelId String   @unique
  name      String
  url       String
  // Scraped channel avatar; null = not fetched yet, "" = fetch attempted, none found.
  avatarUrl String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model QuizResult {
  id         String   @id @default(cuid())
  citationId String
  answeredAt DateTime @default(now())
  score      Float
  citation   Citation @relation(fields: [citationId], references: [id], onDelete: Cascade)

  @@index([citationId])
}

model SikumBook {
  id        String       @id @default(cuid())
  name      String
  author    String?
  icon      String?      @default("📒")
  createdAt DateTime     @default(now())
  entries   SikumEntry[]

  @@index([name])
}

model SikumEntry {
  id        String    @id @default(cuid())
  bookId    String
  book      SikumBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  title     String?
  text      String
  date      DateTime  @default(now())
  dateEnd   DateTime?
  location  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([bookId])
  @@index([date])
}

// One Web Push subscription per browser/device. Possession of endpoint + auth
// is the credential for changing it; ipHash only feeds the signup rate limit.
model PushSubscription {
  id            String   @id @default(cuid())
  endpoint      String   @unique
  p256dh        String
  auth          String
  timeZone      String   @default("Asia/Jerusalem")
  dailyMinutes  Int      @default(480) // minutes after local midnight
  daily         Boolean  @default(true)
  hilula        Boolean  @default(true)
  omer          Boolean  @default(true)
  lastDailyDay  String? // 'YYYY-MM-DD' in the subscription's time zone
  lastHilulaDay String?
  lastOmerDay   String?
  failures      Int      @default(0)
  ipHash        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ipHash, createdAt])
}

// Group quiz (חידון קבוצתי, /play). One row per live game; the question set is
// frozen into `questions` at creation so every device plays the same game.
// `version` bumps on every phase change — transitions are guarded by it so two
// devices (host + lazy timeout) can never advance the same phase twice.
model GameSession {
  id         String       @id @default(cuid())
  code       String       @unique // 6-digit join PIN
  hostHash   String // sha256 of the host's secret key
  status     String       @default("lobby") // lobby | question | reveal | board | ended
  questions  Json
  settings   Json
  current    Int          @default(-1)
  phaseAt    DateTime     @default(now())
  questionMs Int
  version    Int          @default(0)
  ipHash     String
  createdAt  DateTime     @default(now())
  players    GamePlayer[]
  answers    GameAnswer[]

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

model GamePlayer {
  id        String       @id @default(cuid())
  sessionId String
  session   GameSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String
  avatar    String
  keyHash   String // sha256 of the player's secret key
  score     Int          @default(0)
  streak    Int          @default(0)
  kicked    Boolean      @default(false)
  ipHash    String
  joinedAt  DateTime     @default(now())
  answers   GameAnswer[]

  @@unique([sessionId, name])
  @@index([ipHash, joinedAt])
}

model GameAnswer {
  id        String      @id @default(cuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId  String
  player    GamePlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  qIndex    Int
  choice    Int
  correct   Boolean
  points    Int
  ms        Int
  createdAt DateTime    @default(now())

  @@unique([playerId, qIndex])
  @@index([sessionId, qIndex])
}

// רבי־בוט questions. The text fields (question, answer, qHash, ipHash, note)
// are erased after 10 days (lib/rabbiBot/store.ts); the counts stay for stats.
model RabbiBotQuestion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  question  String?
  answer    Json?
  qHash     String?
  ipHash    String?
  note      String?
  status    String
  topic     String?
  model     String?
  cached    Boolean  @default(false)
  points    Int      @default(0)
  verified  Int      @default(0)
  books     String[]
  latencyMs Int      @default(0)
  rating    Int?
  reported  Boolean  @default(false)

  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@index([qHash])
}
